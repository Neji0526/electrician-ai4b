{
  "name": "hill-country-electric-web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Lead-generation website for Hill Country Electric Co. (frontend only)",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "smoke": "vite build --ssr scripts/render-entry.tsx --outDir dist-render --logLevel warn && node scripts/smoke.mjs",
    "gen:placeholders": "node scripts/gen-placeholders.mjs",
    "photos": "node scripts/fetch-photos.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.1"
  }
}
